      4,
      3,
      3,
      3
    ],
    "i_kernels": [
      7,
      5,
      4,
      3,
      3,
      3
    ],
    "d_kernels": [
      5,
      5,
      5,
      5,
      4,
      3
    ]
  },
  "training": {
